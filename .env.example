# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=breathewise-ai-demo
GCP_REGION=us-central1

# Google Vertex AI Configuration
# Supported models: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
VERTEX_AI_MODEL_ID=gemini-1.5-flash

# Firestore Configuration
# Set to 'memory' to run with the zero-dependency in-memory store during local dev/testing
FIRESTORE_MODE=memory

# External Air Quality API (Open-Meteo is free and requires no key)
# Optional WAQI / AQICN token for secondary cross-validation
WAQI_API_KEY=
