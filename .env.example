# ==============================================================================
# BreatheWise AI — Environment Configuration Template
# Copy this file to '.env' in the project root:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SERVER SETTINGS
# ------------------------------------------------------------------------------
# Port for the Express backend API (Default: 5000)
PORT=5000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# Allowed CORS origin for the React Vite frontend (Default: http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000


# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD PLATFORM (GCP) & VERTEX AI CREDENTIALS
# ------------------------------------------------------------------------------
# REQUIRED FOR LIVE GCP SERVICES (Vertex AI & Firestore)
# If left unset or with default values, BreatheWise AI runs seamlessly in
# "Local Fallback Mode" (using the built-in deterministic AI assistant and in-memory DB).

# Your Google Cloud Project ID (from Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Google Cloud Region supporting Vertex AI Gemini models
# Recommended: us-central1, europe-west1, or asia-south1
GCP_REGION=us-central1

# PATH TO GOOGLE SERVICE ACCOUNT KEY FILE:
# To authenticate with Vertex AI and Firestore from your local machine:
# 1. In GCP Console, go to IAM & Admin > Service Accounts.
# 2. Create a service account with roles:
#      - Vertex AI User (roles/aiplatform.user)
#      - Cloud Datastore User (roles/datastore.user)
# 3. Create a JSON key, download it, and place it in the project root (e.g., service-account.json).
# 4. NOTE: service-account*.json is already in .gitignore and will never be committed.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gemini Model Selection for Vertex AI
# Supported models: gemini-1.5-flash (recommended for speed/cost), gemini-2.0-flash, gemini-1.5-pro
VERTEX_AI_MODEL_ID=gemini-1.5-flash


# ------------------------------------------------------------------------------
# 3. PERSISTENCE / DATABASE MODE
# ------------------------------------------------------------------------------
# Choose how user profiles, conversation histories, and impact actions are saved:
#   - 'memory'    : Zero-credential in-memory database (Ideal for local testing & demos)
#   - 'firestore' : Connects to live Google Cloud Firestore (Requires GCP credentials above)
FIRESTORE_MODE=memory


# ------------------------------------------------------------------------------
# 4. EXTERNAL AIR QUALITY TELEMETRY (OPTIONAL)
# ------------------------------------------------------------------------------
# Primary telemetry uses Open-Meteo Air Quality API (100% free, no API key required).
# If you wish to enable secondary cross-validation with WAQI / Aqicn, supply a token below:
# Obtain a free token at: https://aqicn.org/data-platform/token/
WAQI_API_KEY=
